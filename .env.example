# Optional AI advisor. For Claude, set provider/model/key; AI_BASE_URL is optional.
# Claude API calls require an Anthropic Console API key and API billing.
AI_PROVIDER=anthropic
AI_MODEL=
AI_API_KEY=
# Optional Anthropic-compatible API root (default https://api.anthropic.com).
AI_BASE_URL=
# Alternative: OpenAI-compatible or local endpoint.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
# AI_API_KEY=
